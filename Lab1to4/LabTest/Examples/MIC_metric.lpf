        "Annotation"		"NA"	1
        "RatsNest"			"NA"	1
      
      $FILE_MAP	"DXF"		1
        "Copper"			"NA"	0
        "Via"				"NA"	1
        "Board"			"NA"	1
        "NiCr"			"NA"	1

        !!! Layers for packages
        "Footprint"			"NA"	1
