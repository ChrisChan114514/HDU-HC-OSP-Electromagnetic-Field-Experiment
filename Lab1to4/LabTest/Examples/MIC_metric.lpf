!colors  0-black  255-red  32896-gold

    $DRAW_LAYERS_END

    $MODEL_LAYER_BEGIN

        $MAP_NAME	"StdMap" !Name is 32 characters max

        !!! Additional maps can be created if you want to map components to different layers
        !!! User Layers

        "Copper"            "Copper"
        !!! System layers
        "Default"			"Default"
        "SubcircuitAnnotation"	"SubcircuitAnnotation"
        "Annotation"		"Annotation"
        "RatsNest"			"RatsNest"

        !!! Layer mapping for GDSII
        "1_0"			"Copper"
        "2_0"			"Via"
        "3_0"			"Board"
        "4_0"			"NiCr"

        "10_0"		"Footprint"
        "11_0"		"Leads"
        "12_0"		"SolderMask"
        "13_0"		"Package"

        "128_0"		"Default"
        "129_0"		"SubcircuitAnnotation"
        "130_0"		"Annotation"
        "131_0"		"RatsNest"

    $MODEL_LAYER_END

    $FILE_MAPPING_BEGIN

