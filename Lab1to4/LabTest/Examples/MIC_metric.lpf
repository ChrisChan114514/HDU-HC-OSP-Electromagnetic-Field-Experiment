$PROCESS_SETUP_BEGIN

	$DEFAULT_UNITS_BEGIN
		LEN  m
		FREQ M
		CAP  u
		IND  n
		RES  none
		COND none
		TEMP DegC
		ANG  Deg
		TIME n
		VOLT none
		CUR  m
		PWR  m
    $DEFAULT_UNITS_END

    $DBASE_UNIT_BEGIN
    	DRAW_RESOLUTION   .000000001
        GRID_SPACING     .0001
    $DBASE_UNIT_END

    !Create a definition for each type of line

    $LINE_TYPE_BEGIN "Top Copper" !Name is 32 characters max
        !               min width in meters
        "Copper"  0       50e-6     0
    $LINE_TYPE_END

    $VIA_DEFINE_BEGIN
       !Layer    offset  mitre      isCircle
        "2_0"	  0       0     1
    $VIA_DEFINE_END

!--- Registered drawing utility function used for drawing airbridges ------
	$BRIDGE_DRAW_BEGIN NONE $BRIDGE_DRAW_END

	!--- Register cell to be used by default for route vias ------
	$ROUTE_VIA_CELL_BEGIN MICMETROUTEVIA $ROUTE_VIA_CELL_END !Name should be one word
	$CONNECT_RULES_BEGIN 
		Connect "Copper" To "Via"
		Connect_All "Via"
	$CONNECT_RULES_END
	
    !!! Could add a definition here for bottom copper or for top and bottom of stripline, etc.

    !!! These default values are used by the microstrip and stripline library
    $DEFAULT_VALUES_BEGIN
		W		.001
		L		.01
		H		.001
		T		.00005
		Rad		0.002
		Er		3.38
		Rho		1
		Tand	0
		C		1 p
		Li		1 n
		M		0.6
		Cs		.001
		Extn	.01
    $DEFAULT_VALUES_END

$PROCESS_SETUP_END

$LAYER_SETUP_BEGIN

    $DRAW_LAYERS_BEGIN

