    $EM_MAPPING_BEGIN
    	$EM_MAP	"Default"
    	"Copper"			2	0	""
    	"Via"				2	1	""
    $EM_MAPPING_END

    $DRILL_TABLE_BEGIN
        "Default"	1	0.001
	$DRILL_TABLE_END

$LAYER_SETUP_END


!------------- EM Simulation Setup Defined Below ----------------------------

$EM_SETUP_BEGIN
	$DEFAULT_EM_ENCLOSURE_BEGIN
	!-----XDIM-----YDIM-----NX-----NY-----
	!      (m)      (m)
		  10e-3    10e-3    100    100
	$DEFAULT_EM_ENCLOSURE_END

	$DEFAULT_EM_LAYERS_BEGIN
	!	Hatch Patterns ------(0)  |||||(1)  \\\\\(2)  /////(3)  +++++(4)  xxxxx(5)
	!
	!-----T-----Er-----Tand-----Sigma-----Scale-----CondHatch-----ViaHatch-----
	!    (m)                    (S/m)                 (0-5)         (0-5)
	    4.0e-3  1.0     0.0      0.0      1.0          0              1
	  812.8e-6  3.38    0.003    0.0      1.0          2              3
	$DEFAULT_EM_LAYERS_END

	$EM_CONDUCTORS_BEGIN !Conductor names are 32 characters max
		$ELECTRICAL_SPEC_BEGIN
		!-----Name-------rDC-------rHF-------+jX-------Red------Green-----Blue------
		!             (ohm/sq)  (ohm/sq)  (ohm/sq)   <0-255>   <0-255>   <0-255>
		   "Omega Ply"  50.0       0.0       0.0       230        20       50
		$ELECTRICAL_SPEC_END

		$PHYSICAL_SPEC_BEGIN
		!-----Name------T------Sigma-------Red------Green-----Blue------
		!             (m)     (S/m)     <0-255>   <0-255>   <0-255>
		   "1oz Cu"  35.56e-6 5.88e7      128       128        64
		  "1/2oz Cu" 17.78e-6 5.88e7      190       190       120
		$PHYSICAL_SPEC_END
	$EM_CONDUCTORS_END
$EM_SETUP_END
