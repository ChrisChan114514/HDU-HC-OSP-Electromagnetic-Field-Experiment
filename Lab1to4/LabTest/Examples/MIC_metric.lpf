        "Board"			"NA"	1
        "NiCr"			"NA"	1

        !!! Layers for packages
        "Footprint"			"NA"	1
        "Leads"			"NA"	1
        "SolderMask"		"NA"	1
        "Package"			"NA"	1

        !!! System layers
        "Default"			"NA"	1
