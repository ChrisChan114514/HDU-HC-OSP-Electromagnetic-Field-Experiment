!--- Process Definition File Exported from AWR Design Environment (5875)

$PROCESS_SETUP_BEGIN

	$DEFAULT_UNITS_BEGIN
		LEN  mil
		FREQ M
		CAP  p
		IND  n
		RES  none
		COND none
		TEMP DegC
		ANG  Deg
		TIME n
		VOLT none
		CUR  m
		PWR  m
	$DEFAULT_UNITS_END

	$DBASE_UNIT_BEGIN
		DRAW_RESOLUTION	0.005	mil
		GRID_SPACING	1	mil
	$DBASE_UNIT_END

	$LINE_TYPE_BEGIN	"Top Copper"
		! -> Layer 		offset 		minWidth 		flags
		"Copper"		0		5e-005		0
	$LINE_TYPE_END

	$VIA_DEFINE_BEGIN
		! -> Layer 		offset 		mitre 		flags
		"2_0"		0		0		1
	$VIA_DEFINE_END

	!--- Register drawing utility function used for drawing airbridges ------
	$BRIDGE_DRAW_BEGIN NONE $BRIDGE_DRAW_END

	!--- Register cell to be used by default for route vias  ------
	$ROUTE_VIA_CELL_BEGIN MICENGROUTEVIA $ROUTE_VIA_CELL_END

	!--- DRC Rule deck (path relative to lpf file) ------
	$DRC_RULES_FILE_BEGIN "$MWO\drc_rules.txt" $DRC_RULES_FILE_END

	!--- DRC engine: AWR, CALIBRE, ASSURA, CIRANOVA, or POLYTEDA ------
	$DRC_ENGINE_BEGIN "AWR" $DRC_ENGINE_END

	!--- Used by Connectivity tracer ------
	$CONNECT_RULES_BEGIN 
		Connect "Copper" To "Via"
		Connect_All "Via"
		Connect "Copper" To "Footprint" By "Leads"
	$CONNECT_RULES_END 

	!--- Default font used for layout ------
	$DEFAULT_FONT_BEGIN "Arial" 	100000	0	0 	$DEFAULT_FONT_END

	$DEFAULT_VALUES_BEGIN
		W		50		mil
		L		400		mil
		H		32		mil
		T		1.4		mil
		Er		3.38
		Rho		1
		Tand		0
		C		1		p
		Li		1		n
		Rad		100		mil
		M		0.6
		Cs		1		mil
		Extn		100		mil
	$DEFAULT_VALUES_END


$PROCESS_SETUP_END


