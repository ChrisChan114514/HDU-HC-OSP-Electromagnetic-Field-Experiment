!-------------- Process Definition File Exported from Microwave Office --------

$PROCESS_SETUP_BEGIN

	$DEFAULT_UNITS_BEGIN
		LEN  u
		FREQ G
		CAP  p
		IND  n
		RES  none
		COND none
		TEMP DegC
		ANG  Deg
		TIME n
		VOLT none
		CUR  m
		PWR  m
	$DEFAULT_UNITS_END

	$DBASE_UNIT_BEGIN
		DRAW_RESOLUTION	0.01	u
		GRID_SPACING	1	u
	$DBASE_UNIT_END

	$LINE_TYPE_BEGIN	"First Metal Line"
		! -> Layer 		offset 		minWidth 		flags
		"First Metal"		0		5e-06		0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"Outset Line"
		! -> Layer 		offset 		minWidth 		flags
		"First Metal"		0		5e-06		0
		"Pre Plate"		1e-06		4e-06		0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"Inset Line"
		! -> Layer 		offset 		minWidth 		flags
		"First Metal"		0		5e-06		0
		"Pre Plate"		-1e-06		4e-06		0
	$LINE_TYPE_END

	$STRUCT_TYPE_BEGIN	"Tan Resistor"
		! -> Layer 		offset 		minWidth 		flags
		"Resistor"		-2e-06		4e-06		1
		"Second Metal"		0		5e-06		0
		"Pre Plate"		-4e-06		5e-06		0
	$STRUCT_TYPE_END

	$STRUCT_TYPE_BEGIN	"Mesa Resistor"
		! -> Layer 		offset 		minWidth 		flags
		"Implant"		-6e-06		5e-06		0
		"Fet1"		0		5e-06		0
		"Second Metal"		-2e-06		5e-06		0
		"Pre Plate"		-4e-06		4e-06		0
	$STRUCT_TYPE_END

	$CAP_DEFINE_BEGIN
		! -> Layer 		offset 		minWidth 		flags
		"First Metal"		2e-06		5e-06		0
		"Gate"		0		4e-06		0
		"BondPad"		-3e-06		4e-06		0
		"Second Metal"		-2e-06		5e-06		0
	$CAP_DEFINE_END

	$VIA_DEFINE_BEGIN
		! -> Layer 		offset 		minWidth 		flags
		"Fet1"		0		5e-06		0
		"First Metal"		-2e-06		5e-06		0
		"Second Metal"		-5e-06		5e-06		0
		"Pre Plate"		-7e-06		4e-06		0
	$VIA_DEFINE_END

	$PAD_DEFINE_BEGIN
		! -> Layer 		offset 		minWidth 		flags
		"Fet1"		0		5e-06		0
		"First Metal"		-2e-06		5e-06		0
		"Second Metal"		-5e-06		5e-06		0
		"Pre Plate"		-7e-06		4e-06		0
	$PAD_DEFINE_END

	!--- Registered drawing utility function used for drawing airbridges ------
	$BRIDGE_DRAW_BEGIN AWR_MMIC $BRIDGE_DRAW_END

	!--- File used for polygon DRC rules ------
	$DRC_RULES_FILE_BEGIN "$MWO\drc_rules.txt" $DRC_RULES_FILE_END

	$CONNECT_RULES_BEGIN 
		Connect "First Metal" To "Second Metal" by "Nitride Etch"
		Connect "First Metal" To "Via"
		Connect_All "Via"
	$CONNECT_RULES_END
	
	!--- Default font used for layout ------
	$DEFAULT_FONT_BEGIN "Arial" 	100000	0	0 	$DEFAULT_FONT_END

	$DEFAULT_VALUES_BEGIN
		W		34		u
		L		100		u
		H		50		u
		T		2		u
		Er		12.9
		Rho		1
		C		1		p
		Li		1		n
		Rad		200		u
		M		0.6
	$DEFAULT_VALUES_END


$PROCESS_SETUP_END


