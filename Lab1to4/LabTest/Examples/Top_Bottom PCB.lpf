!-------------- Process Definition File Exported from Microwave Office --------
! Note, if you want this to be your default LPF file, please rename it to default.lpf 
! and place it in your root install directory.   
! Also, the default EM structure settings are at the bottom of this file.  
$PROCESS_SETUP_BEGIN

	$DEFAULT_UNITS_BEGIN
		LEN  mil
		FREQ G
		CAP  p
		IND  n
		RES  none
		COND none
		TEMP DegC
		ANG  Deg
		TIME n
		VOLT none
		CUR  m
		PWR  m
	$DEFAULT_UNITS_END

	$DBASE_UNIT_BEGIN
		DRAW_RESOLUTION	0.005	mil
		GRID_SPACING	1	mil
	$DBASE_UNIT_END

	$LINE_TYPE_BEGIN	"15 mil space"
		! -> Layer 		offset 		minWidth 		flags
		"Metal"			0		5e-005			0
		"Metal-"		0.000381	5e-005			0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"25 mil space"
		! -> Layer 		offset 		minWidth 		flags
		"Metal"			0		5e-005			0
		"Metal-"		0.000635	5e-005			0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"50 mil space"
		! -> Layer 		offset 		minWidth 		flags
		"Metal"			0		5e-005			0
		"Metal-"		0.00127		5e-005			0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"75 mil space"
		! -> Layer 		offset 		minWidth 		flags
		"Metal"			0		5e-005			0
		"Metal-"		0.001905	5e-005			0
	$LINE_TYPE_END

	$VIA_DEFINE_BEGIN
		! -> Layer 		offset 		minWidth 		flags
		"Via"			0		0			1
		"Top Copper"	0.000635	0			1
		"Top Copper-"	0.00127	0			1
		"Bottom Copper"	0.000635	0			1
		"Bottom Copper-"	0.00127	0			1
	$VIA_DEFINE_END

	!--- Registered drawing utility function used for drawing airbridges ------
	$BRIDGE_DRAW_BEGIN AWR_MMIC $BRIDGE_DRAW_END

	!--- File used for polygon DRC rules ------
	$DRC_RULES_FILE_BEGIN "$MWO\drc_rules.txt" $DRC_RULES_FILE_END

	$CONNECT_RULES_BEGIN 
		Connect "Top Copper" To "Bottom Copper" by "Via"
	$CONNECT_RULES_END
	
	
	!--- Default font used for layout ------
	$DEFAULT_FONT_BEGIN "Arial" 	100000	0	0 	$DEFAULT_FONT_END

	$DEFAULT_VALUES_BEGIN
		W		50		mil
		L		400		mil
		H		32		mil
		T		1.4		mil
		Er		3.38
		Rho		1
		Tand		0
		C		1		p
		Li		0		n
		Rad		100		mil
		M		0.6
	$DEFAULT_VALUES_END


$PROCESS_SETUP_END


