!-------------- Process Definition File Exported from Microwave Office --------
! Note, if you want this to be your default LPF file, please rename it to default.lpf 
! and place it in your root install directory.   
 

$PROCESS_SETUP_BEGIN

	$DEFAULT_UNITS_BEGIN
		LEN  mil
		FREQ G
		CAP  p
		IND  n
		RES  none
		COND none
		TEMP DegC
		ANG  Deg
		TIME n
		VOLT none
		CUR  m
		PWR  m
	$DEFAULT_UNITS_END

	$DBASE_UNIT_BEGIN
		DRAW_RESOLUTION	0.005	mil
		GRID_SPACING	1	mil
	$DBASE_UNIT_END

	$LINE_TYPE_BEGIN	"line 5 mil space"
		! -> Layer 		offset 		minWidth 		flags
		"Metal"		0		5e-006		0
		"Metal-"		0.000127		5e-006		0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"line 10 mil space"
		! -> Layer 		offset 		minWidth 		flags
		"Metal"		0		5e-006		0
		"Metal-"		0.000254		5e-006		0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"line 20 mil space"
		! -> Layer 		offset 		minWidth 		flags
		"Metal"		0		5e-006		0
		"Metal-"		0.000508		5e-006		0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"line 25 mil space"
		! -> Layer 		offset 		minWidth 		flags
		"Metal"		0		5e-006		0
		"Metal-"		0.000635		5e-006		0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"line 50 mil space"
		! -> Layer 		offset 		minWidth 		flags
		"Metal"		0		5e-006		0
		"Metal-"		0.00127		5e-006		0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"line 75 mil space"
		! -> Layer 		offset 		minWidth 		flags
		"Metal"		0		5e-006		0
		"Metal-"		0.001905		5e-006		0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"line 100 mil space"
		! -> Layer 		offset 		minWidth 		flags
		"Metal"		0		5e-006		0
		"Metal-"		0.00254		5e-006		0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"ground floods"
		! -> Layer 		offset 		minWidth 		flags
		"MS Metal+"		0		5e-006		0
		"SL Metal+"		0		5e-006		0
		"TGr Metal+"		0		5e-006		0
		"BGr Metal"		0		5e-006		0
	$LINE_TYPE_END

	$VIA_DEFINE_BEGIN
		! -> Layer 		offset 		minWidth 		flags
		"Via"		0		5e-006		1
		"vtMetal"		0.000254		5e-006		1
		"vtMetal-"		0.000889		5e-006		1
		"vgMetal-"		0.000889		5e-006		1
		"vbMetal"		0.000254		5e-006		1
		"vbMetal-"		0.000889		5e-006		1
	$VIA_DEFINE_END

	!--- Registered drawing utility function used for drawing airbridges ------
	$BRIDGE_DRAW_BEGIN AWR_MMIC $BRIDGE_DRAW_END

	!--- File used for polygon DRC rules ------
	$DRC_RULES_FILE_BEGIN "$MWO\drc_rules.txt" $DRC_RULES_FILE_END

	$CONNECT_RULES_BEGIN 
		Connect "MS Metal" To "SL Metal" by "Via MS 2 SL"
		Connect "MS Metal" To "TGr Metal" by "Via MS 2 Gnd"
		Connect "SL Metal" To "TGr Metal" by "Via SL 2 Gnd T"
		Connect "SL Metal" To "BGr Metal" by "Via SL 2 Gnd B"
		
	$CONNECT_RULES_END
	
	!--- Default font used for layout ------
	$DEFAULT_FONT_BEGIN "Arial" 	100000	0	0 	$DEFAULT_FONT_END

	$DEFAULT_VALUES_BEGIN
		W		25		mil
		L		100		mil
		H		25		mil
		T		0.0787402		mil
		Er		3.2
		Rho		1
		Tand		0
		C		1		p
		Li		0		n
		Rad		0		mil
		M		0.6
	$DEFAULT_VALUES_END


$PROCESS_SETUP_END


