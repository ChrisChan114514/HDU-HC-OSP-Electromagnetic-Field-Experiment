$EM_SETUP_BEGIN
	$DEFAULT_EM_ENCLOSURE_BEGIN
	!-----XDIM-----YDIM-----NX-----NY-----
	!      (m)      (m)
		0.0008 0.0008 80 80
	$DEFAULT_EM_ENCLOSURE_END

	$DEFAULT_EM_LAYERS_BEGIN
	!	Hatch Patterns ------(0)  |||||(1)  \\\\\(2)  /////(3)  +++++(4)  xxxxx(5)
	!
	!-----T-----Er-----Tand-----Sigma-----Scale-----CondHatch-----ViaHatch-----
	!    (m)                    (S/m)                 (0-5)         (0-5)
