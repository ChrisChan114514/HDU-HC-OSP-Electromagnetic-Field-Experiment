!-------------- Process Definition File Exported from Microwave Office --------

$PROCESS_SETUP_BEGIN

	$DEFAULT_UNITS_BEGIN
		LEN  u
		FREQ G
		CAP  p
		IND  n
		RES  none
		COND none
		TEMP DegC
		ANG  Deg
		TIME n
		VOLT none
		CUR  m
		PWR  m
	$DEFAULT_UNITS_END

	$DBASE_UNIT_BEGIN
		DRAW_RESOLUTION	0.01	u
		GRID_SPACING	1	u
	$DBASE_UNIT_END

	$LINE_TYPE_BEGIN	"Thick Metal Line" !Name is 32 characters max
		! -> Layer 		offset 		minWidth 		flags
		"Thick Metal"		0		5e-06		0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"Plated Metal Line"
		! -> Layer 		offset 		minWidth 		flags
		"Cap Bottom"		0		5e-06		0
		"Thick Metal"		-3e-06		5e-06		0
		"Nitride Etch"		-5e-06		4e-06		0
	$LINE_TYPE_END

	$LINE_TYPE_BEGIN	"Cap Bottom Line"
		! -> Layer 		offset 		minWidth 		flags
		"Cap Bottom"		0		5e-06		0
	$LINE_TYPE_END

	$STRUCT_TYPE_BEGIN	"Tan Resistor" !Name is 32 characters max
		! -> Layer 		offset 		minWidth 		flags
		"Tantalum"		-2e-06		4e-06		0
		"Thick Metal"		0		5e-06		0
	$STRUCT_TYPE_END

	$STRUCT_TYPE_BEGIN	"Mesa Resistor"
		! -> Layer 		offset 		minWidth 		flags
		"Mesa"		-6e-06		5e-06		0
		"Source Drain"		0		5e-06		0
		"Thick Metal"		-2e-06		5e-06		0
		"Nitride Etch"		-4e-06		4e-06		0
	$STRUCT_TYPE_END

	$STRUCT_TYPE_BEGIN	"VIA_LT_0_LT_1"
		! -> Layer 		offset 		minWidth 		flags
		"Nitride Etch"	-5e-06		4e-06		    0
	$STRUCT_TYPE_END

	$STRUCT_TYPE_BEGIN	"VIA_LT_0_LT_2"
		! -> Layer 		offset 		minWidth 		flags
		"Nitride Etch"	-5e-06		4e-06		    0
	$STRUCT_TYPE_END

	$STRUCT_TYPE_BEGIN	"VIA_LT_1_LT_2"
		! -> Layer 		offset 		minWidth 		flags
		"Nitride Etch"	-5e-06		4e-06		    0
	$STRUCT_TYPE_END

	$CAP_DEFINE_BEGIN
		! -> Layer 		offset 		minWidth 		flags
		"Cap Bottom"		2e-06		5e-06		2
		"Poly"		0		4e-06		0
		"Thick Metal"		-2e-06		5e-06		1
	$CAP_DEFINE_END

	$VIA_DEFINE_BEGIN
		! -> Layer 		offset 		minWidth 		flags
		"Source Drain"		0		5e-06		0
		"Via"		-10e-6		5e-06		1
		"Cap Bottom"		-2e-06		5e-06		0
		"Thick Metal"		-5e-06		5e-06		0
		"Nitride Etch"		-7e-06		4e-06		0
	$VIA_DEFINE_END

	$PAD_DEFINE_BEGIN
		! -> Layer 		offset 		minWidth 		flags
		"Source Drain"		0		5e-06		0
		"Cap Bottom"		-2e-06		5e-06		0
		"Thick Metal"		-5e-06		5e-06		0
		"Nitride Etch"		-7e-06		4e-06		0
	$PAD_DEFINE_END

	!--- Registered drawing utility function used for drawing airbridges ------
	$BRIDGE_DRAW_BEGIN AWR_MMIC $BRIDGE_DRAW_END !Name is 32 characters max

	!--- Register cell to be used by default for route vias ------
	$ROUTE_VIA_CELL_BEGIN MMICROUTEVIA $ROUTE_VIA_CELL_END !Name should be one word

	!--- File used for polygon DRC rules ------
	$DRC_RULES_FILE_BEGIN "$MWO\drc_rules.txt" $DRC_RULES_FILE_END
	
	!--- Used by Connectivity tracer ------
	$CONNECT_RULES_BEGIN 
		Connect "Thick Metal" To "Cap Bottom" By "Nitride Etch"
		Connect "Thick Metal" To "Tantalum"
		Connect "Via" To "Cap Bottom"
		Connect "Source Drain" To "Cap Bottom"
		Connect_All "Via"
	$CONNECT_RULES_END 
	!--- Default font used for layout ------
	$DEFAULT_FONT_BEGIN "Arial" 	10000	0	0 	$DEFAULT_FONT_END

	$DEFAULT_VALUES_BEGIN
		W		40		u
		L		100		u
		H		100		u
		T		2		u
		Er		12.9
		Rho		1
		Tand    0
		C		1		p
		Li		1		n
		Rad		50		u
		M		0.6
		Cs		5.0		u
		Extn	100		u
	$DEFAULT_VALUES_END


$PROCESS_SETUP_END


